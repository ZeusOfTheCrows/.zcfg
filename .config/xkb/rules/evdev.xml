<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xkbConfigRegistry SYSTEM "xkb.dtd">
<xkbConfigRegistry version="1.1">
	<layoutList>
		<!-- Declare a new layout and its variants -->
		<layout>
			<!-- Default variant: `default … xkb_symbols "…"` -->
			<configItem>
				<!-- File name of $XDG_CONFIG_HOME/xkb/symbols/customfile -->
				<name>zeus</name>
				<shortDescription>gb</shortDescription>
				<!-- Label: use the value of `name[Group1]` -->
				<description>Zeus Colemak</description>
				<countryList>
					<iso3166Id>GB</iso3166Id>
				</countryList>
				<languageList>
					<iso639Id>eng</iso639Id>
				</languageList>
			</configItem>
			<!-- Other variants -->
			<variantList>
				<variant>
					<configItem>
						<!-- Section name in $XDG_CONFIG_HOME/xkb/symbols/banana -->
						<name>zeusmak_alpha</name>
						<shortDescription>zmal</shortDescription>
						<!-- Label: use the value of `name[Group1]` -->
						<description>Zeus Colemak (No Modifiers)</description>
					</configItem>
				</variant>
				<variant>
					<configItem>
						<!-- Section name in $XDG_CONFIG_HOME/xkb/symbols/banana -->
						<name>colemak_us</name>
						<shortDescription>cmus</shortDescription>
						<!-- Label: use the value of `name[Group1]` -->
						<description>Colemak US</description>
					</configItem>
				</variant>
				<variant>
					<configItem>
						<!-- Section name in $XDG_CONFIG_HOME/xkb/symbols/banana -->
						<name>zeusmak_nonmod</name>
						<shortDescription>zmnm</shortDescription>
						<!-- Label: use the value of `name[Group1]` -->
						<description>Colemak Non-Modular</description>
					</configItem>
				</variant>
			</variantList>
		</layout>

		<layout>
			<configItem>
				<name>gb</name>
				<!-- Keyboard indicator for English layouts -->
				<shortDescription>en</shortDescription>
				<description>English (UK)</description>
				<countryList>
					<iso3166Id>GB</iso3166Id>
				</countryList>
				<languageList>
					<iso639Id>eng</iso639Id>
				</languageList>
			</configItem>
			<variantList>
				<variant>
					<configItem>
						<name>zeusmak</name>
						<description>English (Zeus Colemak)</description>
					</configItem>
				</variant>
			</variantList>
		</layout>
	</layoutList>
</xkbConfigRegistry>
