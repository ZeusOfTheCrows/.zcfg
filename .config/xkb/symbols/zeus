default partial alphanumeric_keys
xkb_symbols "zeusmak" {

	include "zeus(zeusmak_alpha)"
	name[Group1]= "Zeus Colemak";

	// key <ESC> { [     Caps_Lock,    Caps_Lock ] };
	// key <ESC> { [  BackSpace ] };
	key <ESC> { [    Multi_key,    Multi_key ] };


	// key <TLDE> { [     Escape, NoSymbol, NoSymbol, NoSymbol ], type[group1] = "ONE_LEVEL" };
	// replace key <TLDE> { [     Escape ], type[group1] = "ONE_LEVEL" };
	// key <TLDE> { [     Escape ], type[group1] = "ONE_LEVEL" };
	// key <CAPS> { [     Escape ], type[group1] = "ONE_LEVEL" };

	key <TLDE> { [     Escape ], type[group1] = "ONE_LEVEL" };
	key <BKSP> { [      grave,   asciitilde ] };
	key <CAPS> { [  BackSpace ] };
	key <LFSH> { [      Alt_L,     Meta_L ] };
	// key <LCTL> { [  Multi_key,    Multi_key ] };


	key <LCTL> { [    Alt_L,     Meta_L ] };
	key <LSGT> { [  Shift_L,  Caps_Lock,  NoSymbol,  NoSymbol], type[group1]="TWO_LEVEL" };
	key <RTSH> { [  Shift_R,  Caps_Lock,  NoSymbol,  NoSymbol], type[group1]="TWO_LEVEL" };

	// key <LFSH> { [    Multi_key,    Multi_key ] };
	replace key <LALT> { [    Control_L,    Control_L ] };

	replace key <RCTL> { [        Alt_R,        Alt_R ] };
	replace key <RALT> { [    Control_R,    Control_R ] };

	//             None       NumLock    AltGr
	// symbol row
	key <KPDL> { [ KP_Delete,   KP_Decimal,   NoSymbol,  NoSymbol ] };
	key <KP0>  { [ numbersign,        KP_0,   NoSymbol,  NoSymbol ] };
	key <KP1>  { [ A,                 KP_1,   NoSymbol,  NoSymbol ] };
	key <KP2>  { [ B,                 KP_2,   NoSymbol,  NoSymbol ] };
	key <KP3>  { [ C,                 KP_3,   NoSymbol,  NoSymbol ] };
	key <KP4>  { [ D,                 KP_4,   NoSymbol,  NoSymbol ] };
	key <KP5>  { [ E,                 KP_5,   NoSymbol,  NoSymbol ] };
	key <KP6>  { [ F,                 KP_6,   NoSymbol,  NoSymbol ] };
	key <KP7>  { [ equal,             KP_7,   NoSymbol,  NoSymbol ] };
	key <KP8>  { [ x,                 KP_8,   NoSymbol,  NoSymbol ] };
	key <KP9>  { [ colon,             KP_9,   NoSymbol,  NoSymbol ] };
	key <KPDV> { [ parenleft,    KP_Divide,   NoSymbol,  NoSymbol ] };
	key <KPMU> { [ parenright, KP_Multiply,   NoSymbol,  NoSymbol ] };
	key <KPSU> { [ dollar,     KP_Subtract,   NoSymbol,  NoSymbol ] };
	key <KPAD> { [ comma,           KP_Add,   NoSymbol,  NoSymbol ] };
	// key <KPEN> { [ KP_Enter                     ] };
	// key <KPEQ> { [ KP_Equal                     ] };  // mac keyboard only

};

