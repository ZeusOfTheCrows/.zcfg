# include system compose file
include "%L"
# # these are a nice idea, but they end up being buggy for some reason
# # (i.e. don't work in firefox, spotify [electron])
# # "%H" is equivalent to shell "$HOME"
include "%H/.cmps.d/english.compose"
include "%H/.cmps.d/cyrillic.compose"
include "%H/.cmps.d/greek.compose"
include "%H/.cmps.d/multichar.compose"
include "%H/.cmps.d/symbols.compose"

<Multi_key> <z> <z>                     : "ɀ" # swash z
<Multi_key> <Z> <Z>                     : "Ɀ" # swash z (capital)

# <Multi_key> <> <>                     : ""

###############################################################################

# miscellaneous assorted typographical symbols

<Multi_key> <b> <l>                     : "↯" # bliksemschicht, lightning BoLt
# There's multiple unicode bliksems:
#      - ↯ : U+21AF DOWNWARDS ZIGZAG ARROW
#            (in "Arrows" block. unicode comment: "electrolysis")
#            The other one (line below) messes with spacing after, apparently
#      - ⭍ : U+2B4D Downwards Triangle-Headed Zigzag Arrow
#            (in "Miscellaneous Symbols and Arrows" block. no comment)
#      - ☡ : Bourbaki dangerous bend (U+2621 CAUTION SIGN)
#      - 🗲 : ~~not rendered in browsers on linux~~
#      - ⚡️ : shows in colour on most programmes
<Multi_key> <l> <b>                     : "🗲" # lightning bolt

<Multi_key> <z> <grave>                 : "ɀ"
<Multi_key> <z> <asciitilde>            : "ɀ"
<Multi_key> <Z> <asciitilde>            : "Ɀ"
<Multi_key> <z> <z>                     : "ɀ" # swash z
<Multi_key> <Z> <Z>                     : "Ɀ" # swash z (capital)

<Multi_key> <a> <k>                     : "␆"  # acknowledge representation sym
<Multi_key> <n> <k>                     : "␕"  # negative ack representation sym

<Multi_key> <l> <l>                     : "₤"  # pound sign
<Multi_key> <l> <minus>                 : "₤"  # pound sign
<Multi_key> <y> <y>                     : "✔"  # tick / yes
<Multi_key> <n> <n>                     : "✗"  # cross / no
<Multi_key> <j> <y>                     : "〇"  # maru / japanese yes
<Multi_key> <j> <n>                     : "⨉"  # batsu / japanese no
<Multi_key> <r> <q>                     : "⸮"  # reversed question mark
<Multi_key> <question> <less>           : "⸮"
<Multi_key> <less> <question>           : "⸮"
<Multi_key> <x> <x>                     : "×"  # multiply
<Multi_key> <asterisk> <asterisk>       : "⁂"  # asterism
<Multi_key> <plus> <plus>               : "†"  # dagger
<Multi_key> <plus> <asterisk>           : "‡"  # double dagger
<Multi_key> <bar> <exclam>              : "¦"  # broken bar
<Multi_key> <minus> <bar>               : "¬"  # logical not / drop pipe

# ligatures
<Multi_key> <n> <o>                     : "№"  # number sign / numero
<Multi_key> <m> <o>                     : "Nº" # masculine ordinal / alt numero
<Multi_key> <w> <slash>                 : "̅c"  # combining overline / with sign
<Multi_key> <w> <backslash>             : "̄c"  # combining macron / with sign
<Multi_key> <s> <t>                     : "ﬆ"  # st ligature
<Multi_key> <f> <t>                     : "ﬅ"  # long st ligature
<Multi_key> <s> <t>                     : "ﬆ"  # st ligature
<Multi_key> <f> <f>                     : "ﬀ"  # ff ligature
<Multi_key> <f> <i>                     : "ﬁ"  # fi ligature

# quotes:
<Multi_key> <grave> <grave>             : "“"  # like ``...'' in old *nix docs
<Multi_key> <apostrophe> <apostrophe>   : "”"  # closing quote
<Multi_key> <quotedbl> <quotedbl>       : "’"  # apostrophe / right single quote
<Multi_key> <quotedbl> <backslash>      : "〝"  # reversed double prime quote
<Multi_key> <quotedbl> <slash>          : "〞"  # double prime quote

<Multi_key> <o> <underscore>            : "º" #  superscript o (№)
<Multi_key> <period> <bar>              : "⋮" #  vertical elipsis
<Multi_key> <minus> <bar>               : "¬" #  logical not sign
<Multi_key> <space> <space>             : " " #  non-breaking space, default

<Multi_key> <Up> <Up>                   : "↑" #  arrow up
<Multi_key> <Down> <Down>               : "↓" #  arrow down
<Multi_key> <Left> <Left>               : "←" #  arrow left
<Multi_key> <Right> <Right>             : "→" #  arrow right

<Multi_key> <0> <s> <p>                 : "​" U200B  # zero width space
<Multi_key> <0> <n> <j>                 : "‌" U200C  # zero width non-joiner
<Multi_key> <0> <j> <n>                 : "‍" U200D  # zero width joiner
<Multi_key> <s> <e> <c>                 : "§"       # section sign

###############################################################################

# multi-character string sequences

<Multi_key> <s> <f> : "¯\\_(ツ)_/¯" # Shrug

<Multi_key> <minus> <space> : " – " # padded n-dash
<Multi_key> <minus> <minus> <space> : " – " # n-dash with punc spaces (U+2008)
# <Multi_key> <minus> <minus> <space> : " – " # n-dash with thin spaces (U+2009)

# ============== anti-censor workarounds ====================
<Multi_key> <f> <u> : "fuck" #
# alternatives:
	# Mathematical Sans-Serif Small 𝗎 (best)
	# Armenian Small Letter Seh ս
	# Tai Le Letter Pa ᥙ
	# Cyrillic Small Letter es: c (used)
	# Greek lunate sigma symbol: ϲ
	# Small roman numeral one hundred: ⅽ
	# Mathematical sans-serif small k: 𝗄

<Multi_key> <s> <h> : "ѕһіt" #
# alternatives:
	# Cyrillic small letter dze: ѕ (used)
	# Cyrillic small letter shha: һ (used)
	# Mathematical Sans-Serif Small h: 𝗁
	# Cyrillic small letter byelorussian-ukrainian i: і

###############################################################################

# old english / old latin alphabet extension / ipa characters

# ---------- old english letters --------------
<Multi_key> <d> <h>                     : "ð"  # eth (default)
<Multi_key> <D> <H>                     : "Ð"  # ETH (default)
<Multi_key> <g> <h>                     : "ȝ"  # yogh
<Multi_key> <G> <H>                     : "Ȝ"  # YOGH
<Multi_key> <g> <i>                     : "ᵹ"  # insular g
<Multi_key> <G> <I>                     : "Ᵹ"  # INSULAR G
<Multi_key> <r> <r>                     : "ꝛ"  # r rotunda
<Multi_key> <R> <R>                     : "Ꝛ"  # R ROTUNDA
<Multi_key> <f> <s>                     : "ſ"  # long s
<Multi_key> <l> <s>                     : "ſ"  # long s
<Multi_key> <t> <h>                     : "þ"  # thorn (default)
<Multi_key> <T> <H>                     : "Þ"  # THORN (default)
<Multi_key> <w> <w>                     : "ƿ"  # wynn
<Multi_key> <W> <W>                     : "Ƿ"  # WYNN

<Multi_key> <o> <n> <d>                 : "⁊"  # tironian ond

# --------- ipa / phonetic symbols ------------
<Multi_key> <e> <s>                     : "ʃ"  # esh
<Multi_key> <E> <S>                     : "Ʃ"  # ESH
<Multi_key> <e> <z>                     : "ʒ"  # ezh
<Multi_key> <E> <Z>                     : "Ʒ"  # EZH
<Multi_key> <e> <e>                     : "ə"  # schwa
<Multi_key> <E> <E>                     : "Ə"  # SCHWA

<Multi_key> <p> <h>                     : "ɸ"  # voiceless bilabial fricative
<Multi_key> <b> <h>                     : "β"  # voiced bilabial fricative
<Multi_key> <t> <e>                     : "θ"  # voiced dental fricative
<Multi_key> <u> <u>                     : "ʊ"  # near-close near-back rounded
<Multi_key> <i> <u>                     : "ɪ"  # near-close near-front unrounded
<Multi_key> <c> <o>                     : "ɔ"  # open-mid back rounded

